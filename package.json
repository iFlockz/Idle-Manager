{
  "name": "idle-manager",
  "version": "1.0.0",
  "description": "Idle Manager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.Idle Manager.app",
    "productName": "Idle Manager",
    "win": {
      "icon": "icon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "IdleManager.exe"
    },
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "icon.ico"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3"
  }
}
